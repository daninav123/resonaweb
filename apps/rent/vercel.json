{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm install && npm run build --workspace=rent",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://resona-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://resona-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://resona-backend.onrender.com/sitemap-rent.xml"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.resonarent.com" }],
      "destination": "https://resonarent.com/:path*",
      "permanent": true
    },

    { "source": "/favoritos", "destination": "/cuenta/favoritos", "permanent": true },
    { "source": "/mis-pedidos", "destination": "/cuenta/pedidos", "permanent": true },
    { "source": "/mis-pedidos/:id", "destination": "/cuenta/pedidos/:id", "permanent": true },
    { "source": "/orders/:id", "destination": "/cuenta/pedidos/:id", "permanent": true },
    { "source": "/mis-datos", "destination": "/cuenta/datos", "permanent": true },
    { "source": "/perfil", "destination": "/cuenta", "permanent": true },
    { "source": "/register", "destination": "/registro", "permanent": true },

    { "source": "/legal/terminos", "destination": "/terminos-condiciones", "permanent": true },
    { "source": "/legal/privacidad", "destination": "/politica-privacidad", "permanent": true },
    { "source": "/legal/cookies", "destination": "/politica-cookies", "permanent": true },

    { "source": "/checkout/success", "destination": "/checkout/exito", "permanent": true },
    { "source": "/checkout/manual-payment", "destination": "/checkout/manual", "permanent": true },
    { "source": "/pagar/:token", "destination": "/pago/token/:token", "permanent": true },
    { "source": "/modification-payment/:id", "destination": "/pago/modificacion/:id", "permanent": true },

    { "source": "/catalogo", "destination": "/productos", "permanent": true },
    { "source": "/servicios", "destination": "/productos", "permanent": true },
    { "source": "/servicios/alquiler-mesa-mezclas-dj", "destination": "/servicios/alquiler-mesa-mezcla-dj", "permanent": true },
    { "source": "/servicios/alquiler-pantallas-led-eventos", "destination": "/servicios/alquiler-pantallas-led", "permanent": true },
    { "source": "/servicios/alquiler-proyectores-profesionales", "destination": "/servicios/alquiler-proyectores", "permanent": true },
    { "source": "/servicios/alquiler-subwoofers-graves", "destination": "/servicios/alquiler-subwoofers", "permanent": true },
    { "source": "/servicios/alquiler-laser-eventos", "destination": "/servicios/alquiler-laser", "permanent": true },
    { "source": "/servicios/alquiler-maquinas-fx-humo-confeti", "destination": "/servicios/alquiler-maquinas-fx", "permanent": true },
    { "source": "/servicios/alquiler-iluminacion-bodas-valencia", "destination": "/servicios/alquiler-iluminacion-bodas", "permanent": true },

    { "source": "/blog", "destination": "https://resonaevents.com/blog", "permanent": true },
    { "source": "/blog/:slug", "destination": "https://resonaevents.com/blog/:slug", "permanent": true },
    { "source": "/bodas-valencia", "destination": "https://resonaevents.com/bodas", "permanent": true },
    { "source": "/sonido-bodas-valencia", "destination": "https://resonaevents.com/sonido-bodas-valencia", "permanent": true },
    { "source": "/calculadora", "destination": "https://resonaevents.com/calculadora-evento", "permanent": true },
    { "source": "/calculadora-evento", "destination": "https://resonaevents.com/calculadora-evento", "permanent": true },
    { "source": "/calculadora-eventos", "destination": "https://resonaevents.com/calculadora-evento", "permanent": true },
    { "source": "/servicios/sonido-bodas-valencia", "destination": "https://resonaevents.com/servicios/sonido-bodas-valencia", "permanent": true },
    { "source": "/servicios/sonido-iluminacion-bodas-valencia", "destination": "https://resonaevents.com/servicios/sonido-iluminacion-bodas-valencia", "permanent": true },
    { "source": "/servicios/produccion-eventos-valencia", "destination": "https://resonaevents.com/servicios/produccion-eventos-valencia", "permanent": true },
    { "source": "/servicios/produccion-tecnica-eventos-valencia", "destination": "https://resonaevents.com/servicios/produccion-tecnica-eventos", "permanent": true },
    { "source": "/servicios/sonido-eventos-corporativos-valencia", "destination": "https://resonaevents.com/servicios/sonido-eventos-corporativos", "permanent": true },
    { "source": "/servicios/videoescenarios-streaming-eventos", "destination": "https://resonaevents.com/servicios/videoescenarios-streaming", "permanent": true },
    { "source": "/servicios/iluminacion-arquitectonica-eventos", "destination": "https://resonaevents.com/servicios/iluminacion-arquitectonica", "permanent": true },
    { "source": "/servicios/iluminacion-escenarios-eventos", "destination": "https://resonaevents.com/servicios/iluminacion-escenarios", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://connect.facebook.net https://js.stripe.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://resona-backend.onrender.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net https://td.doubleclick.net https://www.facebook.com https://connect.facebook.net https://api.stripe.com https://m.stripe.network https://maps.googleapis.com https://nominatim.openstreetmap.org https://res.cloudinary.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://m.stripe.network https://www.googletagmanager.com https://sis.redsys.es https://sis-t.redsys.es; form-action 'self' https://sis.redsys.es https://sis-t.redsys.es; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
